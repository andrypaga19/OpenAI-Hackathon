{
  "name": "BioMatch Startup CV question bank",
  "version": "2.0",
  "date": "2026-10-24",
  "notes": "req = [D1, D2, D3, D4]; R = required, O = optional (bonus), - = hidden at that band. Points are 0-1 per answer. proof = public identifier needed for that answer to count in full (proof rule).",
  "bands": {
    "D1": { "name": "Discovery", "trl": "1-3", "typicalRounds": ["Pre-seed", "Seed"] },
    "D2": { "name": "Lead and candidate", "trl": "4", "typicalRounds": ["Seed", "Series A"] },
    "D3": { "name": "IND/CTA-enabling", "trl": "5", "typicalRounds": ["Series A"] },
    "D4": { "name": "Clinical", "trl": "6-7", "typicalRounds": ["Series B", "Series C+"] }
  },
  "dimensions": [
    { "id": "TM", "name": "Team" },
    { "id": "SC", "name": "Science and evidence" },
    { "id": "PD", "name": "Product and plan" },
    { "id": "IP", "name": "IP and exclusivity" },
    { "id": "RC", "name": "Regulatory and clinical" },
    { "id": "CM", "name": "CMC" },
    { "id": "MK", "name": "Market" },
    { "id": "FN", "name": "Financing" },
    { "id": "EV", "name": "External validation" }
  ],
  "weights": {
    "D1": { "TM": 25, "SC": 30, "PD": 10, "IP": 10, "RC": 5, "CM": 0, "MK": 10, "FN": 5, "EV": 5 },
    "D2": { "TM": 20, "SC": 25, "PD": 15, "IP": 10, "RC": 5, "CM": 5, "MK": 10, "FN": 5, "EV": 5 },
    "D3": { "TM": 15, "SC": 20, "PD": 15, "IP": 15, "RC": 10, "CM": 10, "MK": 5, "FN": 5, "EV": 5 },
    "D4": { "TM": 15, "SC": 20, "PD": 10, "IP": 10, "RC": 15, "CM": 10, "MK": 10, "FN": 5, "EV": 5 }
  },
  "weightModifiers": [
    { "id": "cgt", "when": "module CT or GT selected", "shift": { "SC": -5, "CM": 5 }, "reason": "Manufacturing risk weighs more for cell and gene therapy" }
  ],
  "trlOptions": [
    { "label": "TRL 1-2: research idea and protocols", "band": "D1" },
    { "label": "TRL 3: hypothesis testing, initial proof of concept", "band": "D1" },
    { "label": "TRL 4: candidate proof of concept and early safety in a defined model", "band": "D2" },
    { "label": "TRL 5: preclinical studies, IND/IMPD in preparation", "band": "D3" },
    { "label": "TRL 6: IND/IMPD approved, Phase 1 running or done", "band": "D4" },
    { "label": "TRL 7: Phase 2 completed, Phase 3 planned or running", "band": "D4" }
  ],
  "modalityOptions": [
    { "label": "Small molecule", "module": "SM" },
    { "label": "Antibody", "module": "BI" },
    { "label": "Antibody-drug conjugate", "module": "BI" },
    { "label": "Other protein or peptide", "module": "BI" },
    { "label": "Cell therapy", "module": "CT" },
    { "label": "Gene therapy", "module": "GT" },
    { "label": "Gene editing", "module": "GT" },
    { "label": "RNA (siRNA, ASO)", "module": "RN" },
    { "label": "mRNA", "module": "RN" },
    { "label": "Vaccine", "module": null },
    { "label": "Radiopharmaceutical", "module": null },
    { "label": "Microbiome", "module": null }
  ],
  "modules": {
    "SM": { "name": "Small molecule" },
    "BI": { "name": "Biologics" },
    "CT": { "name": "Cell therapy" },
    "GT": { "name": "Gene therapy and editing" },
    "RN": { "name": "RNA and oligonucleotides" },
    "PL": { "name": "Platform", "trigger": "P09 = platform with lead asset or platform only" }
  },
  "proofTypes": {
    "doi": { "label": "DOI", "check": "Crossref REST API /works/{doi}" },
    "patent": { "label": "Patent publication number", "check": "EPO Open Patent Services /published-data/publication/epodoc/{number}/biblio" },
    "trial": { "label": "Trial registry ID (NCT or EU CT number)", "check": "ClinicalTrials.gov API v2 /studies/{NCT_ID}; EU CT number via CTIS public search" },
    "grant": { "label": "Grant ID or public award page", "check": "NIH RePORTER API v2 /projects/search; CORDIS or funder page link" },
    "link": { "label": "Public link", "check": "URL reachable; spot-checked" },
    "names": { "label": "Public names", "check": "Shown on profile; not verified" }
  },
  "profile": [
    { "id": "P01", "label": "Company name, website, logo", "type": "text", "usedFor": "Listing" },
    { "id": "P02", "label": "One-line pitch (max 140 characters)", "type": "text", "usedFor": "Search, cards, thesis similarity" },
    { "id": "P03", "label": "HQ country and city", "type": "dropdown", "usedFor": "Geography fit" },
    { "id": "P04", "label": "Founding year", "type": "number", "usedFor": "Display" },
    { "id": "P05", "label": "Origin and institution", "type": "dropdown", "options": ["University spin-out", "Research institute spin-out", "Pharma carve-out", "VC-created", "Independent"], "usedFor": "Display, conflict check" },
    { "id": "P06", "label": "Modalities", "type": "multi", "usedFor": "Modality modules, modality fit" },
    { "id": "P07", "label": "Therapeutic areas", "type": "multi", "options": ["Oncology", "Immunology and inflammation", "Neurology", "Rare and genetic disease", "Cardiometabolic", "Infectious disease", "Ophthalmology", "Respiratory", "Dermatology", "Other"], "usedFor": "Area fit" },
    { "id": "P08", "label": "Lead indication", "type": "text", "usedFor": "Market questions, conflict check" },
    { "id": "P09", "label": "Company type", "type": "dropdown", "options": ["Asset-centric", "Platform with lead asset", "Platform only"], "usedFor": "Asset/platform fit, platform module" },
    { "id": "P10", "label": "Development stage (TRL)", "type": "dropdown", "usedFor": "Selects the band template" },
    { "id": "P11", "label": "Current round", "type": "dropdown", "options": ["Pre-seed", "Seed", "Series A", "Series B", "Series C+", "Bridge"], "usedFor": "Round fit, plausibility check" },
    { "id": "P12", "label": "Target raise (range) and amount committed", "type": "range", "usedFor": "Ticket fit" },
    { "id": "P13", "label": "Lead investor", "type": "dropdown", "options": ["Need a lead", "Have a lead", "Follow-on only"], "usedFor": "Role fit" },
    { "id": "P14", "label": "Investor types sought", "type": "multi", "options": ["Specialist biotech VC", "Generalist VC", "Corporate VC", "Family office", "Angel network", "Impact or public fund"], "usedFor": "Investor-type filter" },
    { "id": "P15", "label": "Preferred investor regions", "type": "multi", "usedFor": "Geography fit" },
    { "id": "P16", "label": "Value-add wanted", "type": "multi", "options": ["Company building", "Clinical and regulatory expertise", "CMC network", "Pharma BD network", "Recruiting", "Follow-on capacity"], "usedFor": "Value-add fit" },
    { "id": "P17", "label": "Target closing date", "type": "month", "usedFor": "Timing fit" },
    { "id": "P18", "label": "Non-confidential pitch deck and attestation", "type": "file", "usedFor": "Listing gate, VC review" }
  ],
  "questions": [
    { "id": "TM01", "dim": "TM", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Commitment",
      "prompt": "How many founders or executives work full-time for the company?",
      "options": [ { "label": "None yet", "points": 0 }, { "label": "One", "points": 0.6 }, { "label": "Two or more", "points": 1 } ] },
    { "id": "TM02", "dim": "TM", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Drug-development judgment",
      "prompt": "What is the deepest drug-development experience in your leadership team?",
      "options": [ { "label": "None", "points": 0 }, { "label": "Academic translational research only", "points": 0.3 }, { "label": "Advisor with industry R&D experience", "points": 0.5 }, { "label": "Executive with industry R&D experience", "points": 0.8 }, { "label": "Executive who has taken an asset into the clinic", "points": 1 } ] },
    { "id": "TM03", "actionable": false, "dim": "TM", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Track record",
      "prompt": "Has anyone in the founding team built a company before?",
      "options": [ { "label": "No", "points": 0 }, { "label": "Yes, a VC-backed company", "points": 0.6 }, { "label": "Yes, with an exit or licensing deal", "points": 1, "proof": "link" } ] },
    { "id": "TM04", "dim": "TM", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Leadership",
      "prompt": "Who leads the company today?",
      "options": [ { "label": "Scientific founder, first operating role", "points": 0.4 }, { "label": "Founder with a prior operating role", "points": 0.7 }, { "label": "Experienced biotech CEO", "points": 1 } ] },
    { "id": "TM05", "dim": "TM", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Hiring plan",
      "prompt": "Do you have a hiring plan for key gaps (e.g. CMO, CMC lead, CFO, BD)?",
      "options": [ { "label": "No plan yet", "points": 0 }, { "label": "Gaps named", "points": 0.5 }, { "label": "Gaps named with timing, funded by this round", "points": 1 } ] },
    { "id": "TM06", "dim": "TM", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Advisors",
      "prompt": "Who advises you scientifically and clinically?",
      "options": [ { "label": "No advisors yet", "points": 0 }, { "label": "Informal advisors", "points": 0.4 }, { "label": "Named advisory board with at least two KOLs in the indication", "points": 1, "proof": "names" } ] },
    { "id": "TM07", "dim": "TM", "module": "core", "req": ["-", "O", "R", "R"], "criterion": "Board",
      "prompt": "How is your board composed?",
      "options": [ { "label": "Founders only", "points": 0.3 }, { "label": "Includes an investor director", "points": 0.7 }, { "label": "Includes an independent industry director", "points": 1 } ] },

    { "id": "SC01", "dim": "SC", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Target confidence (right target)",
      "prompt": "What is the strongest evidence that your target drives the disease?",
      "help": "Name the type of evidence only – no data.",
      "options": [ { "label": "Literature hypothesis", "points": 0.2 }, { "label": "Functional validation in vitro", "points": 0.4 }, { "label": "Validation in an in-vivo disease model", "points": 0.6 }, { "label": "Human genetic evidence", "points": 0.9, "proofOptional": "doi" }, { "label": "Clinical validation of the mechanism", "points": 1, "proofOptional": "doi" } ] },
    { "id": "SC02", "dim": "SC", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Evidence package", "type": "checklist", "scoring": "bandExpected",
      "prompt": "Which evidence do you have today? Tick all that apply.",
      "help": "Scored against what is expected at your band; each extra item adds 0.05.",
      "items": [
        { "key": "ivpoc", "label": "In-vitro proof of concept" },
        { "key": "te", "label": "Target engagement shown" },
        { "key": "ive", "label": "In-vivo efficacy in a disease-relevant model" },
        { "key": "pkpd", "label": "PK/PD or dose-response relationship" },
        { "key": "ngtox", "label": "Early (non-GLP) safety or tolerability data" },
        { "key": "gtox", "label": "GLP toxicology completed" },
        { "key": "hsafe", "label": "Human safety data", "proof": "trial" },
        { "key": "heff", "label": "Human efficacy signal", "proof": "trial" }
      ],
      "expected": {
        "D1": ["ivpoc", "te"],
        "D2": ["ivpoc", "te", "ive", "pkpd"],
        "D3": ["ivpoc", "te", "ive", "pkpd", "ngtox", "gtox"],
        "D4": ["ivpoc", "te", "ive", "pkpd", "ngtox", "gtox", "hsafe"]
      } },
    { "id": "SC03", "dim": "SC", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Reproducibility",
      "prompt": "Has your key result been reproduced?",
      "options": [ { "label": "Single lab, single series of experiments", "points": 0.2 }, { "label": "Reproduced in-house in independent experiments", "points": 0.5 }, { "label": "Reproduced by a CRO or a second academic lab", "points": 0.9 }, { "label": "Reproduced by a pharma partner", "points": 1 } ] },
    { "id": "SC04", "dim": "SC", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Exposure (right tissue)",
      "prompt": "Have you shown exposure at the site of action?",
      "options": [ { "label": "Not yet assessed", "points": 0 }, { "label": "Predicted by modelling", "points": 0.4 }, { "label": "Measured in animals", "points": 0.8 }, { "label": "Measured in humans", "points": 1 } ] },
    { "id": "SC05", "dim": "SC", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Safety (right safety)",
      "prompt": "How have you assessed safety liabilities?",
      "options": [ { "label": "Not yet assessed", "points": 0 }, { "label": "Literature and target-biology review", "points": 0.4 }, { "label": "Experimental screen (off-target panel or early tox)", "points": 0.8 }, { "label": "GLP toxicology complete", "points": 1 } ] },
    { "id": "SC06", "dim": "SC", "module": "core", "req": ["O", "O", "R", "R"], "criterion": "Patient selection (right patient)",
      "prompt": "How will you select the right patients?",
      "options": [ { "label": "No strategy yet", "points": 0 }, { "label": "Hypothesis", "points": 0.4 }, { "label": "Biomarker identified", "points": 0.7 }, { "label": "Biomarker assay or companion diagnostic plan", "points": 1 } ] },
    { "id": "SC07", "actionable": false, "dim": "SC", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Differentiation", "scoring": "withBullets",
      "prompt": "How is your product positioned against the standard of care?",
      "help": "Add three differentiation points (max 120 characters each). Describe what it does, not how.",
      "options": [ { "label": "First-in-class", "points": 1 }, { "label": "Best-in-class with a stated advantage", "points": 0.9 }, { "label": "Repurposing with new IP", "points": 0.6 }, { "label": "Fast follower", "points": 0.5 } ] },
    { "id": "SC08", "dim": "SC", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "De-risking plan",
      "prompt": "Is your next kill/go experiment defined?",
      "options": [ { "label": "Not defined", "points": 0 }, { "label": "Defined", "points": 0.6 }, { "label": "Defined, funded and scheduled within 12 months", "points": 1 } ] },

    { "id": "PD01", "dim": "PD", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Focus",
      "prompt": "How focused is your lead indication?",
      "options": [ { "label": "Several candidates, undecided", "points": 0.3 }, { "label": "Lead indication chosen", "points": 0.7 }, { "label": "Lead chosen, follow-on indications mapped", "points": 1 } ] },
    { "id": "PD02", "dim": "PD", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Target Product Profile",
      "prompt": "Do you have a Target Product Profile (TPP)?",
      "options": [ { "label": "No", "points": 0 }, { "label": "Draft", "points": 0.5 }, { "label": "Written and reviewed with clinicians or advisors", "points": 1 } ] },
    { "id": "PD03", "dim": "PD", "module": "core", "req": ["-", "O", "R", "R"], "criterion": "Pipeline depth",
      "prompt": "How deep is your pipeline?",
      "options": [ { "label": "Single program", "points": 0.5 }, { "label": "Lead plus backup candidate", "points": 0.8 }, { "label": "Lead, backup and a second program", "points": 1 } ] },
    { "id": "PD04", "dim": "PD", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Capital efficiency",
      "prompt": "What is your plan to the next value-inflection point?",
      "options": [ { "label": "No plan yet", "points": 0 }, { "label": "Milestones listed", "points": 0.5 }, { "label": "Milestones with dates and budget, funded by this round", "points": 1 } ] },
    { "id": "PD05", "actionable": false, "dim": "PD", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Capital efficiency", "type": "number",
      "prompt": "How many months to your next value-inflection point?",
      "bins": [ { "max": 24, "points": 1 }, { "max": 36, "points": 0.7 }, { "max": 9999, "points": 0.4 } ] },

    { "id": "IP01", "dim": "IP", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Filing",
      "prompt": "What is the most advanced IP filing for your lead program?",
      "help": "Status only – never upload claims or unpublished applications.",
      "options": [ { "label": "None yet", "points": 0 }, { "label": "Invention disclosed to the tech-transfer office", "points": 0.2 }, { "label": "Priority application filed", "points": 0.5 }, { "label": "PCT application filed", "points": 0.75 }, { "label": "Patent granted in a major market", "points": 1, "proof": "patent" } ] },
    { "id": "IP02", "dim": "IP", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Ownership",
      "prompt": "Who owns the core IP?",
      "options": [ { "label": "University or institute, no agreement yet", "points": 0.2 }, { "label": "Option agreement signed", "points": 0.5 }, { "label": "Licence terms agreed", "points": 0.7 }, { "label": "Exclusive licence signed", "points": 0.9 }, { "label": "Company-owned", "points": 1 } ] },
    { "id": "IP03", "dim": "IP", "module": "core", "req": ["-", "O", "R", "R"], "criterion": "Freedom to operate",
      "prompt": "Has freedom to operate been assessed?",
      "options": [ { "label": "Not assessed", "points": 0 }, { "label": "Informal landscape search", "points": 0.4 }, { "label": "Professional FTO analysis in progress", "points": 0.7 }, { "label": "Professional FTO opinion completed", "points": 1 } ] },
    { "id": "IP04", "dim": "IP", "module": "core", "req": ["-", "O", "R", "R"], "criterion": "Exclusivity horizon",
      "prompt": "How many years of protection remain after expected launch?",
      "options": [ { "label": "Unknown", "points": 0 }, { "label": "Under 5 years", "points": 0.3 }, { "label": "5-10 years", "points": 0.7 }, { "label": "Over 10 years", "points": 1 } ] },
    { "id": "IP05", "dim": "IP", "module": "core", "req": ["O", "O", "O", "O"], "criterion": "Exclusivity horizon", "type": "multi", "scoring": "max",
      "prompt": "Which additional exclusivity applies? Tick all that apply.",
      "options": [ { "label": "Orphan exclusivity likely", "points": 0.7 }, { "label": "Regulatory data exclusivity", "points": 0.5 }, { "label": "Process know-how or trade secrets", "points": 0.5 } ] },

    { "id": "RC01", "dim": "RC", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Regulatory pathway",
      "prompt": "How defined is your regulatory pathway?",
      "options": [ { "label": "Not yet defined", "points": 0 }, { "label": "Target agencies named", "points": 0.5 }, { "label": "Pathway and key requirements mapped", "points": 1 } ] },
    { "id": "RC02", "dim": "RC", "module": "core", "req": ["-", "O", "R", "R"], "criterion": "Agency interaction",
      "prompt": "Have you interacted with a regulator?",
      "options": [ { "label": "No", "points": 0 }, { "label": "Meeting planned with a date", "points": 0.4 }, { "label": "INTERACT, pre-IND or scientific advice held", "points": 1 } ] },
    { "id": "RC03", "dim": "RC", "module": "core", "req": ["O", "O", "O", "O"], "criterion": "Expedited designations",
      "prompt": "Which status do your expedited designations have (orphan, fast track, breakthrough, RMAT, PRIME)?",
      "options": [ { "label": "None", "points": 0 }, { "label": "Planned", "points": 0.3 }, { "label": "Applied", "points": 0.5 }, { "label": "Granted", "points": 1, "proof": "link" } ] },
    { "id": "RC04", "dim": "RC", "module": "core", "req": ["-", "O", "R", "R"], "criterion": "Realistic clinical plan",
      "prompt": "How developed is your first-in-human plan?",
      "options": [ { "label": "Not started", "points": 0 }, { "label": "Outline: population and endpoints", "points": 0.5 }, { "label": "Protocol synopsis with CRO or sites identified", "points": 1 } ] },
    { "id": "RC05", "actionable": false, "dim": "RC", "module": "core", "req": ["-", "-", "-", "R"], "criterion": "Human data",
      "prompt": "What is your clinical status?",
      "help": "Add the registry ID of each trial (NCT or EU CT number).",
      "options": [ { "label": "Phase 1 ongoing", "points": 0.5, "proof": "trial" }, { "label": "Phase 1 complete", "points": 0.7, "proof": "trial" }, { "label": "Phase 2 ongoing", "points": 0.8, "proof": "trial" }, { "label": "Phase 2 readout available", "points": 1, "proof": "trial" } ] },

    { "id": "CM01", "dim": "CM", "module": "core", "req": ["-", "R", "R", "R"], "criterion": "Manufacturing route",
      "prompt": "How will you manufacture?",
      "options": [ { "label": "Not defined", "points": 0 }, { "label": "Research-grade material only", "points": 0.3 }, { "label": "CDMO identified", "points": 0.6 }, { "label": "CDMO contracted or own GMP capability", "points": 1 } ] },
    { "id": "CM02", "dim": "CM", "module": "core", "req": ["-", "-", "R", "R"], "criterion": "GMP readiness",
      "prompt": "What is your GMP material status?",
      "options": [ { "label": "Not planned", "points": 0 }, { "label": "Planned with a date", "points": 0.5 }, { "label": "GMP batch produced", "points": 1 } ] },
    { "id": "CM03", "dim": "CM", "module": "core", "req": ["-", "O", "O", "R"], "criterion": "Cost of goods",
      "prompt": "Have you estimated cost of goods at commercial scale?",
      "options": [ { "label": "Not assessed", "points": 0 }, { "label": "Qualitative view", "points": 0.5 }, { "label": "COGS estimate", "points": 1 } ] },
    { "id": "CM04", "dim": "CM", "module": "core", "req": ["-", "O", "O", "O"], "criterion": "Supply risk",
      "prompt": "Have you assessed critical supply risks?",
      "options": [ { "label": "Not assessed", "points": 0 }, { "label": "Identified", "points": 0.5 }, { "label": "Mitigated (second source or reserved capacity)", "points": 1 } ] },

    { "id": "MK01", "dim": "MK", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Sized opportunity",
      "prompt": "How have you sized the patient population for your lead indication?",
      "options": [ { "label": "Not sized", "points": 0 }, { "label": "Estimate without a source", "points": 0.4 }, { "label": "Sourced epidemiology", "points": 0.8, "proof": "link" }, { "label": "Sourced epidemiology plus price analogues", "points": 1, "proof": "link" } ] },
    { "id": "MK02", "dim": "MK", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Unmet need",
      "prompt": "Have you described the current standard of care and its limitations?",
      "options": [ { "label": "No", "points": 0 }, { "label": "Yes", "points": 1 } ] },
    { "id": "MK03", "dim": "MK", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Competitive position",
      "prompt": "How have you mapped the competition?",
      "options": [ { "label": "Not mapped", "points": 0 }, { "label": "Competitors named", "points": 0.5 }, { "label": "Competing programs mapped by mechanism and stage, with positioning", "points": 1 } ] },
    { "id": "MK04", "dim": "MK", "module": "core", "req": ["O", "R", "R", "R"], "criterion": "Exit logic",
      "prompt": "What is your partnering or exit thesis?",
      "options": [ { "label": "None yet", "points": 0 }, { "label": "Thesis stated", "points": 0.5 }, { "label": "Thesis with at least two comparable deals", "points": 1, "proof": "link" } ] },
    { "id": "MK05", "dim": "MK", "module": "core", "req": ["-", "-", "O", "R"], "criterion": "Pricing",
      "prompt": "Do you have a pricing and reimbursement hypothesis?",
      "options": [ { "label": "No", "points": 0 }, { "label": "Analogue-based hypothesis", "points": 0.6 }, { "label": "Payer input gathered", "points": 1 } ] },

    { "id": "FN01", "dim": "FN", "module": "core", "req": ["R", "R", "R", "R"], "criterion": "Use of funds",
      "prompt": "How are the funds from this round allocated?",
      "options": [ { "label": "Not specified", "points": 0 }, { "label": "Budget categories", "points": 0.4 }, { "label": "Milestones with budget", "points": 1 } ] },
